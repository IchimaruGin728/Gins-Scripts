name: "🍿️ DualSubs: ➕ AddOn (Microsoft Translate)"
desc: |-
  DualSubs 额外插件
  切换为微软翻译并自动刷新Token
openUrl: "http://boxjs.com/#/app/DualSubs.AddOn"
author: |-
  VirgilClyne[https://github.com/VirgilClyne]
homepage: "https://DualSubs.github.io/guide/addon"
icon: "https://github.com/DualSubs/AddOn/raw/main/src/assets/icon_rounded.png"
category: "🍿️ DualSubs"
date: "2024-12-10 08:54:52"
version: "1.0.8"

cron:
  script:
    - name: "🍿️ DualSubs.AddOn.Microsoft.Translate"
      cron: "*/10 * * * *" # at every 10th minute
      argument: # optional, if the script needs arguments

script-providers:
  "🍿️ DualSubs.AddOn.Microsoft.Translate":
    url: https://github.com/DualSubs/AddOn/releases/download/v1.0.8/Microsoft.Translate.bundle.js
    interval: 86400
