name: "🍿️ DualSubs: 🎵 Spotify"
desc: |-
  Spotify 增强及双语歌词
openUrl: "http://boxjs.com/#/app/DualSubs.Spotify"
author: |-
  VirgilClyne[https://github.com/VirgilClyne]
homepage: "https://DualSubs.github.io/guide/spotify"
icon: "https://github.com/DualSubs/Spotify/raw/main/src/assets/icon_rounded.png"
category: "🍿️ DualSubs"
date: "2025-10-25 04:40:57"
version: "1.9.12"

http:
  mitm:
    - "api.spotify.com"
    - "spclient.wg.spotify.com"
    - "*-spclient.spotify.com"
  script:
    - match: ^https?:\/\/api\.spotify\.com\/v1\/tracks\?
      name: 🍿️ DualSubs.Spotify.response
      type: response
      require-body: true

    - match: ^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json
      name: 🍿️ DualSubs.Spotify.request
      type: request
      require-body: true
    - match: ^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/\w+\?(.*)
      name: 🍿️ DualSubs.Spotify.request
      type: request
      require-body: true
      binary-mode: true

    - match: ^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=Translate
      name: 🍿️ DualSubs.Translate.Lyrics.response
      type: response
      require-body: true
    - match: ^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=Translate
      name: 🍿️ DualSubs.Translate.Lyrics.response
      type: response
      require-body: true
      binary-mode: true

    - match: ^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/(.+)\?(.*)format=json(.*)subtype=External
      name: 🍿️ DualSubs.External.Lyrics.response
      type: response
      require-body: true
    - match: ^https?:\/\/(.+-spclient|spclient\.wg).spotify\.com(:443)?\/color-lyrics\/v2\/track\/\w+\?(.*)subtype=External
      name: 🍿️ DualSubs.External.Lyrics.response
      type: response
      require-body: true
      binary-mode: true

script-providers:
  🍿️ DualSubs.Spotify.request:
    url: https://github.com/DualSubs/Spotify/releases/download/v1.9.12/request.bundle.js
    interval: 86400
  🍿️ DualSubs.Spotify.response:
    url: https://github.com/DualSubs/Spotify/releases/download/v1.9.12/response.bundle.js
    interval: 86400
  🍿️ DualSubs.Translate.Lyrics.response:
    url: https://github.com/DualSubs/Universal/releases/latest/download/Translate.response.bundle.js
    interval: 86400
  🍿️ DualSubs.External.Lyrics.response:
    url: https://github.com/DualSubs/Universal/releases/latest/download/External.Lyrics.response.bundle.js
    interval: 86400
